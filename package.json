    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
